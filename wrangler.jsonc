{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "langcheng-drive",
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "drive-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "langcheng-drive-files" }],
  "vars": {
    "ENABLE_UPLOADS": "false", "TOTAL_CAPACITY_BYTES": "1000000000",
    "MAX_FILE_BYTES": "50000000", "RETENTION_SECONDS": "86400",
    "TURNSTILE_SITE_KEY": "", "TURNSTILE_HOSTNAMES": "drive.langcheng.uk"
  }
}
