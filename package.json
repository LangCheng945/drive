{
  "name": "langcheng-drive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "wrangler pages dev .svelte-kit/cloudflare",
    "db:local": "wrangler d1 migrations apply drive-db --local",
    "db:remote": "wrangler d1 migrations apply drive-db --remote",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name langcheng-drive",
    "deploy:cleanup": "wrangler deploy --config wrangler.cleanup.jsonc"
  },
  "dependencies": {
    "@lucide/svelte": "1.72.0",
    "qrcode": "1.5.4",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261112.1",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "typescript": "6.0.3",
    "svelte-check": "4.7.8",
    "wrangler": "4.160.1",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.2",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "@types/qrcode": "1.5.6",
    "vitest": "5.1.0",
    "miniflare": "5.20261110.1-beta",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
