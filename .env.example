# Copy to .dev.vars (Wrangler secrets); never commit real values.
# Create a separate development widget allowing localhost and 127.0.0.1.
# Official dummy keys omit action and return example.com; they intentionally
# cannot pass this application's strict hostname/action checks.
TURNSTILE_SECRET_KEY=replace-with-real-development-widget-secret
TURNSTILE_SITE_KEY=replace-with-real-development-widget-site-key
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
ADMIN_TOKEN=replace-with-at-least-32-random-characters
RATE_LIMIT_SALT=replace-with-another-32-random-characters
ENABLE_UPLOADS=true
